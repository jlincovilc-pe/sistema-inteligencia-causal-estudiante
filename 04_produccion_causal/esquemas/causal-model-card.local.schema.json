{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "causal-model-card.local.schema.json",
  "title": "Model card causal local v0.2",
  "description": "Contrato local de producción alineado con el alcance del Apéndice G: la falsificación es evidencia, los no observables no se declaran verificados y la sensibilidad puede quedar explícitamente sin cuantificación válida.",
  "type": "object",
  "required": ["schema_version", "modelo", "estimando", "datos", "estimacion", "supuestos", "puerta", "limitaciones", "uso_previsto", "entorno"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "local-0.2" },
    "modelo": {
      "type": "object",
      "required": ["nombre", "version", "creado"],
      "additionalProperties": false,
      "properties": {
        "nombre": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "creado": { "type": "string", "format": "date-time" }
      }
    },
    "estimando": {
      "type": "object",
      "required": ["tipo", "definicion"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "enum": ["ATE", "CATE"] },
        "definicion": { "type": "string", "minLength": 10 }
      }
    },
    "datos": {
      "type": "object",
      "required": ["n", "sha256", "fuente"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fuente": { "type": "string", "minLength": 1 }
      }
    },
    "estimacion": {
      "type": "object",
      "required": ["metodo", "ate", "se", "ic95", "k_folds", "semilla"],
      "properties": {
        "metodo": { "type": "string" },
        "ate": { "type": "number" },
        "se": { "type": "number", "minimum": 0 },
        "ic95": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "k_folds": { "type": "integer", "minimum": 2 },
        "semilla": { "type": "integer" }
      }
    },
    "supuestos": {
      "type": "object",
      "required": ["observables", "no_observables"],
      "properties": {
        "observables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["nombre", "prueba", "valor", "umbral_alerta", "umbral_falla", "estado", "verificado_en"],
            "properties": {
              "nombre": { "type": "string" },
              "prueba": { "type": "string" },
              "valor": { "type": "number" },
              "umbral_alerta": { "type": "number" },
              "umbral_falla": { "type": "number" },
              "estado": { "enum": ["pasa", "alerta", "falla"] },
              "verificado_en": { "type": "string", "format": "date-time" }
            }
          }
        },
        "no_observables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["nombre", "justificacion", "sensibilidad", "criterio_revision"],
            "additionalProperties": false,
            "properties": {
              "nombre": { "type": "string" },
              "justificacion": { "type": "string", "minLength": 20 },
              "sensibilidad": {
                "type": "object",
                "required": ["metodo", "estado"],
                "additionalProperties": false,
                "properties": {
                  "metodo": { "type": "string", "minLength": 1 },
                  "estado": { "enum": ["cuantificada", "sin_cuantificacion_valida"] },
                  "objeto": { "type": "string", "minLength": 1 },
                  "escala": { "type": "string", "minLength": 1 },
                  "valor": { "type": "number" },
                  "limitacion": { "type": "string", "minLength": 10 }
                },
                "allOf": [
                  {
                    "if": { "properties": { "estado": { "const": "cuantificada" } }, "required": ["estado"] },
                    "then": { "required": ["objeto", "escala", "valor"] }
                  },
                  {
                    "if": { "properties": { "estado": { "const": "sin_cuantificacion_valida" } }, "required": ["estado"] },
                    "then": { "required": ["limitacion"] }
                  }
                ]
              },
              "contraste_experimental": {
                "type": "object",
                "description": "Opcional: sesgo estimado contra un holdout aleatorizado.",
                "required": ["sesgo", "ic95_sesgo"],
            "additionalProperties": false,
            "properties": {
                  "sesgo": { "type": "number" },
                  "ic95_sesgo": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
                }
              },
              "criterio_revision": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "puerta": {
      "type": "object",
      "required": ["estado"],
      "additionalProperties": false,
      "properties": {
        "estado": { "enum": ["pasa", "alerta", "falla"] },
        "chequeos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nombre", "clave", "valor", "umbral_alerta", "umbral_falla", "estado"],
            "additionalProperties": false,
            "properties": {
              "nombre": { "type": "string", "minLength": 1 },
              "clave": { "type": "string", "minLength": 1 },
              "valor": { "type": "number" },
              "umbral_alerta": { "type": "number" },
              "umbral_falla": { "type": "number" },
              "estado": { "enum": ["pasa", "alerta", "falla"] },
              "origen_umbral": { "type": "string" }
            }
          }
        }
      }
    },
    "limitaciones": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "uso_previsto": { "type": "string", "minLength": 10 },
    "entorno": {
      "type": "object",
      "required": ["python", "librerias"],
      "additionalProperties": false,
      "properties": {
        "python": { "type": "string" },
        "librerias": { "type": "object", "additionalProperties": { "type": "string" } },
        "commit": { "type": ["string", "null"] }
      }
    }
  }
}
